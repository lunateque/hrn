{
  "manifest_version": 3,
  "name": "hrn Browser Relay",
  "version": "0.1.1",
  "description": "Bridges Chrome tabs over Chrome Native Messaging to the local hrn agent relay.",
  "key": "",
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
